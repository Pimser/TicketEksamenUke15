<%- include("partials/header") -%>

<title><%= tick.title %></title>

<body>

    <p class="ticket-title">
        <%= tick.title %> 
    </p>
    <p style="font-weight: bold; font-size: 15px; color: lightsalmon;">Created by:
         <a href="/user/<%= tick.user._id %>"><%= tick.user.username %></a>
    </p>
    <br>
    <br>
    <div class="ticket-description">
        <% tick.description.split("\n").forEach(line => { %>
            <p style="font-weight: bold;"><%= line %></p>
        <% }) %>
    </div>
    <br>
    <br>
    <p style="font-weight: bold;">Tags: <span class="tag-text"> <%= tick.tags %></span></p>
    <br>
    <br>
    
    <h3>Comments:</h3>
    <br>
    <div>
        <% if (comments && comments.length > 0) { %>
        <% comments.forEach(comment => { %>
        <div class="comment">
            <p><strong><%= comment.user.username %></strong>:</p>
            <p><%= comment.content %></p>
            <p style="font-size: 0.9em; color: grey;">Posted on: <%= comment.createdAt.toLocaleString() %></p>
            <hr>
        </div>
     <% }); %>
     <% } else { %>  <!-- Hvis det ikke er noen kommentarer, vis en melding -->
        <p>No comments yet.</p>
    <% } %>
    </div>

    <form action="/tickets/<%= tick._id %>/comment" method="POST">
        <textarea name="content" placeholder="Add a comment.." required></textarea>
        <button type="submit">Post comment</button>
    </form>

    <br>
    <br>
    <a href="/dashboard" style="font-size: 15px; color: grey;">(<) Back</a>

</body>